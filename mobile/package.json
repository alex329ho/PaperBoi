{
  "name": "paperboi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "bin": {
    "expo": "./scripts/expo-cli.js"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "node ./scripts/link-expo-wrapper.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky install",
    "build:dev": "eas build --profile development --platform all",
    "build:prod": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "expo": "^51.0.20",
    "expo-build-properties": "^0.12.0",
    "expo-constants": "^16.0.2",
    "expo-font": "^12.0.6",
    "expo-notifications": "~0.28.11",
    "expo-router": "^3.5.24",
    "expo-secure-store": "~13.0.1",
    "firebase": "^11.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-paper": "^5.12.6",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "typescript": "~5.3.3",
    "uuid": "^9.0.0",
    "react-native-get-random-values": "^1.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-community/cli-server-api": "^13.6.9",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.6.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.12.1",
    "@typescript-eslint/parser": "^8.12.1",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^11.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "firebase-tools": "^14.27.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.2.0",
    "envinfo": "^7.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
