{
  "info": {
    "name": "PaperBoi Backend-Mobile Integration",
    "_postman_id": "c1bc9c5b-2dbf-4bb4-9c42-0d9e38d33b1f",
    "description": "Collection covering auth, preferences, news, summaries, and email flows for PaperBoi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"integration@example.com\",\n  \"password\": \"Pass1234!\",\n  \"name\": \"Integration User\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"integration@example.com\",\n  \"password\": \"Pass1234!\"\n}"
        }
      }
    },
    {
      "name": "Preferences - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/preferences", "host": ["{{base_url}}"], "path": ["api", "v1", "preferences"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topics\": [\"ai\", \"finance\"],\n  \"regions\": [\"US\"],\n  \"languages\": [\"en\"],\n  \"notification_time\": \"07:30\",\n  \"summary_length\": \"SHORT\",\n  \"email_frequency\": \"daily\"\n}"
        }
      }
    },
    {
      "name": "News - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/news?topics=ai&regions=US&languages=en&limit=5",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "news"],
          "query": [
            { "key": "topics", "value": "ai" },
            { "key": "regions", "value": "US" },
            { "key": "languages", "value": "en" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "News - Summarize",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/news/{{article_id}}/summarize",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "news", "{{article_id}}", "summarize"]
        },
        "body": { "mode": "raw", "raw": "{ \"length\": \"SHORT\" }" }
      }
    },
    {
      "name": "Email - Send Summary",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/email/send-summary", "host": ["{{base_url}}"], "path": ["api", "v1", "email", "send-summary"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipients\": [\"integration@example.com\"],\n  \"topics\": [\"ai\", \"finance\"],\n  \"include_count\": 3\n}"
        }
      }
    },
    {
      "name": "Mock Server - Fetch Fresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{mock_base_url}}/api/v1/news/fetch-fresh", "host": ["{{mock_base_url}}"], "path": ["api", "v1", "news", "fetch-fresh"] },
        "body": { "mode": "raw", "raw": "{ \"query\": \"ai\", \"region\": \"US\" }" }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://api.paperboi.app" },
    { "key": "mock_base_url", "value": "http://localhost:9000" },
    { "key": "access_token", "value": "replace-with-token" },
    { "key": "article_id", "value": "1" }
  ]
}
