PAPERBOI_DATABASE_URL=postgresql+asyncpg://paperboi:paperboi@db:5432/paperboi
PAPERBOI_DATABASE_SSL_MODE=disable
PAPERBOI_REDIS_URL=redis://cache:6379/0

PAPERBOI_JWT_SECRET_KEY=change_this_secret
