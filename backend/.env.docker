PAPERBOI_ENVIRONMENT=development
PAPERBOI_DEBUG=true
PAPERBOI_APP_NAME=PaperBoi
PAPERBOI_API_V1_PREFIX=/api/v1
PAPERBOI_HOST=0.0.0.0
