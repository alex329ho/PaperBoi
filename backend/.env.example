# Environment variables for PaperBoi backend
APP_NAME=PaperBoi Backend
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://paperboi:paperboi@db:5432/paperboi
REDIS_URL=redis://cache:6379/0

GDELT_API_URL=https://api.gdeltproject.org/api/v2/summary/summary
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=grok-4.1-fast

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOURKEY\n-----END PRIVATE KEY-----\n"

SCHEDULER_TIMEZONE=UTC
SCHEDULER_NEWS_CRON="0 */2 * * *"
